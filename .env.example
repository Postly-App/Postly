# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma + Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/postly?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postly?schema=public"

# NextAuth (obligatoire : secret ; en prod sur Vercel utiliser https pour NEXTAUTH_URL si domaine custom)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# OAuth login providers (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Social account connect providers
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Chiffrement AES-256-GCM des jetons SocialAccount (obligatoire en prod pour connecter / OAuth callback)
# Génère : openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# UploadThing
UPLOADTHING_TOKEN=

# Cron
CRON_SECRET=replace-with-random-string

# Rate limiting (Upstash Redis — serverless / Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optionnel : "1" pour désactiver tout rate limiting (urgence / debug uniquement)
# RATE_LIMIT_DISABLED=1

# OpenAI — assistant IA dashboard (/api/ai/chat) uniquement
OPENAI_API_KEY=
# Optionnel (défaut : gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Groq — chatbot landing visiteurs (/api/chat). Récupère une clé sur https://console.groq.com/keys
GROQ_API_KEY=
# Optionnel (défaut : llama-3.3-70b-versatile)
GROQ_VISITOR_MODEL=
